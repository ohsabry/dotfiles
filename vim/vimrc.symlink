set nocompatible
set encoding=utf-8
set nobackup
set nowritebackup
set noswapfile
set updatetime=300
set shortmess+=c
set cmdheight=2

syntax enable

call plug#begin('~/.vim/plugged')

" UI
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'
Plug 'catppuccin/vim', { 'as': 'catppuccin' }

" Project
Plug 'junegunn/fzf',                      { 'dir': '~/.fzf', 'do': './install --all' }
Plug 'junegunn/fzf.vim'

" Tmux
Plug 'christoomey/vim-tmux-navigator'

" Editing
Plug 'tpope/vim-repeat'
Plug 'tpope/vim-surround'
Plug 'tpope/vim-commentary'
Plug 'editorconfig/editorconfig-vim'
Plug 'bronson/vim-trailing-whitespace'
Plug 'christoomey/vim-sort-motion'
Plug 'tpope/vim-unimpaired'
Plug 'jeffkreeftmeijer/vim-numbertoggle'

" Git
Plug 'airblade/vim-gitgutter'

" Linting
Plug 'dense-analysis/ale'

" CSS
Plug 'ap/vim-css-color', { 'for': 'css' }

" HTML
Plug 'mattn/emmet-vim', { 'for': 'html' }

" Go
Plug 'fatih/vim-go', { 'do': ':GoUpdateBinaries' }

" Autocomplete
Plug 'neoclide/coc.nvim', {'branch': 'release'}

" Misc
Plug 'mbbill/undotree'
Plug 'sheerun/vim-polyglot'
Plug 'vim-test/vim-test'

" Markdown
Plug 'junegunn/goyo.vim'
Plug 'junegunn/limelight.vim'

call plug#end()

inoremap jk <Esc>
nmap j gj
nmap k gk
nmap <C-e> :e#<CR>

let mapleader=","
noremap \ ,

nnoremap <leader>w :FixWhitespace<CR>
nnoremap <leader>u :UndotreeToggle<CR>
nnoremap <leader>f :ALEFix<CR>

autocmd FileType go nmap <leader>b  <Plug>(go-build)
autocmd FileType go nmap <leader>r  <Plug>(go-run)
let g:go_def_mode='gopls'
let g:go_info_mode='gopls'
let g:go_def_mapping_enabled = 0

autocmd CursorHold * silent call CocActionAsync('highlight')

nnoremap <leader>x :cclose<CR>
map <leader>n :cnext<CR>
map <leader>m :cprevious<CR>

nmap <leader>tn :TestNearest<CR>
nmap <leader>tf :TestFile<CR>
nmap <leader>ts :TestSuite<CR>
nmap <leader>tl :TestLast<CR>

nmap <Leader>a :Rg<CR>
nmap ; :Buffers<CR>

noremap <leader>i gg=G''
noremap <leader>l :set invrelativenumber<CR>

set shell=zsh
set autoindent
set autoread
set backspace=indent,eol,start
set clipboard=unnamed
set complete-=i
set copyindent
set cursorline
set expandtab
set gdefault
set lazyredraw
set matchtime=2
set notitle
set nowrap
set nrformats-=octal
set number
set relativenumber
set ruler
set scrolloff=4
set secure
set showcmd
set showmatch
set smarttab
set splitbelow
set splitright
set ttimeout
set ttimeoutlen=0
set timeoutlen=1000
set wildmenu
set tabstop=2
set softtabstop=2
set shiftwidth=2
set shiftround
set hidden
set noshowmode

" better search
set incsearch                   " incremental searching
set hlsearch                    " highlight matches
set ignorecase                  " searches are case insensitive...
set smartcase                   " ... unless they contain at least one capital letter

set autowrite                   " writes content of the file immedietely if you call :make

" clear search highlight with Escape
nnoremap <Esc> :nohlsearch<CR>

" Use tab for trigger completion with characters ahead and navigate.
" NOTE: Use command ':verbose imap <tab>' to make sure tab is not mapped by
" other plugin before putting this into your config.
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1):
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

" Make <CR> to accept selected completion item or notify coc.nvim to format
" <C-g>u breaks current undo, please make your own choice.
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"

function! CheckBackspace() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" Remap keys for gotos
nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr <Plug>(coc-references)

let g:go_code_completion_enabled = 0

let g:go_highlight_structs = 0
let g:go_highlight_interfaces = 0
let g:go_highlight_operators = 0

autocmd BufNewFile,BufRead *.go setlocal noexpandtab tabstop=4 shiftwidth=4

" Linting
let g:ale_lint_on_text_changed = 'never'
let g:ale_linters = {
      \   'python': ['mypy', 'ruff'],
      \   'javascript': ['eslint'],
      \   'css': ['stylelint'],
      \   'scss': ['stylelint'],
      \   'glsl': ['glslang'],
      \   'html': ['prettier'],
      \   'json': ['jsonlint'],
      \   'yaml': ['yamllint'],
      \   'ruby': ['rubocop'],
      \   'sql': ['sqlint'],
      \   'dockerfile': ['hadolint'],
      \   'markdown': ['mdl', 'proselint'],
      \   'c': ['clang'],
      \   'bash': ['shellcheck']
      \}

let g:ale_fixers = {
      \   'python': ['ruff'],
      \   'javascript': ['eslint'],
      \   'typescript': ['eslint'],
      \   'typescriptreact': ['eslint'],
      \   'scss': ['prettier'],
      \   'css': ['stylelint'],
      \   'ruby': ['rubocop'],
      \   'html': ['prettier'],
      \   'json': ['prettier'],
      \   'bash': ['shfmt'],
      \   'go': ['goimports']
      \}

let g:ale_sign_column_always = 1
let g:ale_sign_error = '-'
let g:ale_sign_warning = '>'

nmap ]l :ALENextWrap<CR>
nmap [l :ALEPreviousWrap<CR>

" Git
let g:gitgutter_sign_added = '∙'
let g:gitgutter_sign_modified = '∙'
let g:gitgutter_sign_removed = '∙'
let g:gitgutter_sign_modified_removed = '∙'

" UI
set termguicolors
set background=dark
silent! colorscheme catppuccin_mocha

" better display for :set list
if &listchars ==# 'eol:$'
  set listchars=tab:>\ ,trail:-,extends:>,precedes:<,nbsp:+
endif
set laststatus=2

" automatically rebalance windows on vim resize
autocmd VimResized * :wincmd =

" airline
let g:airline_powerline_fonts = 1
let g:airline#extensions#ale#enabled = 1
let g:airline_skip_empty_sections = 1
let g:airline_theme = 'catppuccin_mocha'

" FZF
" Insert mode remaps
inoremap <expr> <c-x><c-k> fzf#vim#complete#word({'left': '15%'})
imap <c-x><c-f> <plug>(fzf-complete-path)
imap <c-x><c-j> <plug>(fzf-complete-file)

" Search for tasks across the current project
nnoremap <C-p> :Files<cr>

au BufRead,BufNewFile .eslintrc set ft=json

augroup Markdown
  autocmd!
  autocmd FileType markdown set wrap
  autocmd FileType markdown set lbr
augroup END

autocmd! User GoyoEnter Limelight
autocmd! User GoyoLeave Limelight!

autocmd! User GoyoEnter nested set eventignore=FocusGained
autocmd! User GoyoLeave nested set eventignore=
