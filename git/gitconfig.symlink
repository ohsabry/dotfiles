[user]
	name = Omar Sabry
	email = ohsabry@gmail.com

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.gitignore
	editor = vim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = Catppuccin Mocha

[alias]
	unstage = reset
	uncommit = reset --soft HEAD^
	mup = !git checkout $(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@') && git pull && git checkout -

[pull]
	ff = only
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[github]
	user = ohsabry

[diff]
	algorithm = histogram

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = 1

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
