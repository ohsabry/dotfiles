export LANG=en_CA.UTF-8
export LC_ALL=en_CA.UTF-8

export DEV_DIR="${DEV_DIR:-$HOME/dev}"
export ZSH="$DEV_DIR/dotfiles"
export VISUAL='vim'
export EDITOR="$VISUAL"
export PAGER=less
export LESS=-r

# Homebrew (Apple Silicon + Intel)
if [ -d "/opt/homebrew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  export PATH="/usr/local/bin:$PATH"
fi

# Personal bins take priority over everything
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Machine-specific config (credentials, paths, work aliases)
if [[ -f ~/.localrc ]]; then
  source ~/.localrc
else
  echo "\033[33m⚠ ~/.localrc not found — run 'dot' to generate one\033[0m"
fi

typeset -U config_files
config_files=($ZSH/*/*.zsh)

for file in ${(M)config_files:#*/path.zsh}; do source "$file"; done
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}; do source "$file"; done

autoload -U compinit
compinit

for file in ${(M)config_files:#*/completion.zsh}; do source "$file"; done

eval "$(zoxide init zsh)"
unset config_files

# fzf + ripgrep
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS='--reverse'
source <(fzf --zsh)

export GOPATH="${GOPATH:-$DEV_DIR/go}"
export PATH="$PATH:$GOPATH/bin"

# mise — manages node, python, ruby versions
eval "$(mise activate zsh)"
